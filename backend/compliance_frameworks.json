          "requirement_type": "REPORTING",
          "criticality": "CRITICAL",
          "detection_keywords": ["false certification", "misrepresentation", "knowingly false", "certification accuracy"],
          "risk_weight": 2.5,
          "compliance_score_weight": 2.5,
          "legal_reference": "https://www.soxlaw.com/section-906.html"
        }
      ]
