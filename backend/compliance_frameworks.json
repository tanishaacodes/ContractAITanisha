          "criticality": "HIGH",
          "detection_keywords": ["real-time disclosure", "material change", "financial condition", "issuer disclosure", "rapid reporting"],
          "risk_weight": 1.5,
          "compliance_score_weight": 1.5,
          "legal_reference": "https://www.soxlaw.com/section-409.html"
        },
        {
          "requirement_code": "SOX Section 802",
          "requirement_name": "Criminal Penalties for Altering Documents",
          "description": "Whoever knowingly destroys, conceals, covers up, falsifies, or makes false entries in any record document or tangible object with the intent to obstruct or influence federal investigation shall be subject to criminal penalties",
          "requirement_type": "AUDIT",
          "criticality": "CRITICAL",
          "detection_keywords": ["record retention", "document destruction", "document alteration", "falsification", "evidence tampering", "audit trail"],
          "risk_weight": 2.5,
          "compliance_score_weight": 2.5,
          "legal_reference": "https://www.soxlaw.com/section-802.html"
        },
        {
          "requirement_code": "SOX Section 906",
          "requirement_name": "Criminal Penalties for False Certification",
