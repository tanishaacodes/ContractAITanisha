{
  "frameworks": [
    {
      "code": "GDPR",
      "name": "General Data Protection Regulation",
      "description": "EU regulation on data protection and privacy for individuals within the EU",
      "jurisdiction": "European Union",
      "effective_date": "2018-05-25",
      "version": "2016/679",
      "is_active": true,
      "priority": 1,
      "requirements": [
        {
          "requirement_code": "GDPR Art. 6",
          "requirement_name": "Lawfulness of processing",
          "description": "Processing shall be lawful only if and to the extent that at least one of the following applies: (a) the data subject has given consent, (b) processing is necessary for contract performance, (c) processing is necessary for legal obligation, (d) processing is necessary to protect vital interests, (e) processing is necessary for public task, (f) processing is necessary for legitimate interests",
          "requirement_type": "DATA_PROTECTION",
          "criticality": "CRITICAL",
          "detection_keywords": ["consent", "data processing", "lawful basis", "legitimate interest", "personal data processing", "data subject consent", "processing purpose", "legal obligation"],
          "risk_weight": 2.0,
          "compliance_score_weight": 2.0,
          "legal_reference": "https://gdpr-info.eu/art-6-gdpr/"
        },
        {
          "requirement_code": "GDPR Art. 7",
          "requirement_name": "Conditions for consent",
          "description": "Where processing is based on consent, the controller shall be able to demonstrate that the data subject has consented to processing of their personal data",
          "requirement_type": "CONSENT",
          "criticality": "CRITICAL",
          "detection_keywords": ["explicit consent", "informed consent", "consent mechanism", "opt-in", "permission", "data subject agreement"],
          "risk_weight": 2.0,
          "compliance_score_weight": 2.0,
          "legal_reference": "https://gdpr-info.eu/art-7-gdpr/"
        },
        {
          "requirement_code": "GDPR Art. 9",
          "requirement_name": "Processing of special categories of personal data",
          "description": "Processing of personal data revealing racial or ethnic origin, political opinions, religious or philosophical beliefs, or trade union membership, and processing of genetic data, biometric data for identification purposes, data concerning health or data concerning sex life or sexual orientation shall be prohibited unless explicit consent or other legal basis applies",
          "requirement_type": "DATA_PROTECTION",
          "criticality": "CRITICAL",
          "detection_keywords": ["special category", "sensitive data", "biometric", "health data", "genetic data", "sexual orientation", "religious belief"],
          "risk_weight": 2.5,
          "compliance_score_weight": 2.5,
          "legal_reference": "https://gdpr-info.eu/art-9-gdpr/"
        },
        {
          "requirement_code": "GDPR Art. 13",
          "requirement_name": "Information to be provided where personal data are collected from the data subject",
          "description": "Where personal data relating to a data subject are collected from the data subject, the controller shall provide the data subject with all of the following information at the time when personal data are obtained",
          "requirement_type": "DATA_PROTECTION",
          "criticality": "HIGH",
          "detection_keywords": ["data collection", "information provision", "privacy notice", "data subject information", "collection statement"],
          "risk_weight": 1.5,
          "compliance_score_weight": 1.5,
          "legal_reference": "https://gdpr-info.eu/art-13-gdpr/"
        },
        {
          "requirement_code": "GDPR Art. 17",
          "requirement_name": "Right to erasure ('right to be forgotten')",
          "description": "The data subject shall have the right to obtain from the controller the erasure of personal data concerning them without undue delay, and the controller shall have the obligation to erase personal data without undue delay",
          "requirement_type": "DATA_PROTECTION",
          "criticality": "HIGH",
          "detection_keywords": ["data deletion", "right to erasure", "right to be forgotten", "data removal", "delete personal data", "erasure request"],
          "risk_weight": 1.5,
          "compliance_score_weight": 1.5,
          "legal_reference": "https://gdpr-info.eu/art-17-gdpr/"
        },
        {
          "requirement_code": "GDPR Art. 32",
          "requirement_name": "Security of processing",
          "description": "The controller and processor shall implement appropriate technical and organisational measures to ensure a level of security appropriate to the risk, including inter alia: (a) pseudonymization and encryption, (b) ability to restore availability, (c) process for regularly testing effectiveness",
          "requirement_type": "SECURITY",
          "criticality": "CRITICAL",
          "detection_keywords": ["data security", "encryption", "security measures", "technical safeguards", "data protection measures", "security breach", "data breach notification", "pseudonymization"],
          "risk_weight": 2.0,
          "compliance_score_weight": 2.0,
          "legal_reference": "https://gdpr-info.eu/art-32-gdpr/"
        },
        {
          "requirement_code": "GDPR Art. 33",
          "requirement_name": "Notification of a personal data breach to the supervisory authority",
          "description": "In the case of a personal data breach, the controller shall without undue delay and, where feasible, not later than 72 hours after having become aware of the personal data breach, notify the personal data breach to the supervisory authority",
          "requirement_type": "BREACH_NOTIFICATION",
          "criticality": "HIGH",
          "detection_keywords": ["breach notification", "data breach", "security incident", "unauthorized access", "breach reporting", "incident notification", "72 hours"],
          "risk_weight": 1.5,
          "compliance_score_weight": 1.5,
          "legal_reference": "https://gdpr-info.eu/art-33-gdpr/"
        },
        {
          "requirement_code": "GDPR Art. 35",
          "requirement_name": "Data Protection Impact Assessment",
          "description": "Where a type of processing in particular using new technologies, is likely to result in a high risk to the rights and freedoms of natural persons, the controller shall, prior to the processing, carry out an assessment of the impact of the envisaged processing operations on the protection of personal data",
          "requirement_type": "AUDIT",
          "criticality": "MEDIUM",
          "detection_keywords": ["DPIA", "data protection impact assessment", "risk assessment", "processing assessment", "impact analysis"],
          "risk_weight": 1.0,
          "compliance_score_weight": 1.0,
          "legal_reference": "https://gdpr-info.eu/art-35-gdpr/"
        },
        {
          "requirement_code": "GDPR Art. 45",
          "requirement_name": "Transfers on the basis of an adequacy decision",
          "description": "A transfer of personal data to a third country may take place where the European Commission has decided that the third country ensures an adequate level of protection",
          "requirement_type": "DATA_PROTECTION",
          "criticality": "HIGH",
          "detection_keywords": ["data transfer", "international transfer", "third country", "adequacy decision", "cross-border data", "data export"],
          "risk_weight": 1.5,
          "compliance_score_weight": 1.5,
          "legal_reference": "https://gdpr-info.eu/art-45-gdpr/"
        }
      ]
    },
    {
